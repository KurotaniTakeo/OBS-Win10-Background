{
  "name": "obs-config-server",
  "version": "1.1.1",
  "description": "配置文件服务器，用于 OBS 背景配置管理",
  "main": "src/server.js",
  "bin": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "build": "pkg . --targets node18-win-x64 --output dist/obs-config-server.exe"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "configs/config.default.json"
    ],
    "outputPath": "dist"
  },
  "keywords": [
    "obs",
    "config",
    "server"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KurotaniTakeo/OBS-Win10-Background.git"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "pkg": "^5.8.0"
  },
  "author": "",
  "license": "MIT"
}
